[Unit]
Description=Intraday NSE dashboard (Streamlit UI, daily Kite login)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=intraday
WorkingDirectory=/opt/intraday-dashboard
EnvironmentFile=/opt/intraday-dashboard/.env
Environment=KITE_TOKEN_FILE=/opt/intraday-dashboard/state/.kite_token
Environment=PAPER_TRADING_FILE=/opt/intraday-dashboard/state/paper_trades.json
ExecStart=/opt/intraday-dashboard/venv/bin/streamlit run app.py \
    --server.port=8501 --server.address=0.0.0.0 --server.headless=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
