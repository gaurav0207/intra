KITE_API_KEY=
KITE_API_SECRET=

# Email notifications (Gmail example; use an App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=you@gmail.com
ALERT_EMAIL=you@gmail.com

# Public HTTPS dashboard. Set the same URL as the Kite developer redirect URL.
APP_URL=https://trade.example.com
DOMAIN=trade.example.com
DASHBOARD_USER=admin
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'password'
DASHBOARD_PASSWORD_HASH=

# Optional; defaults to paper_trades.json
PAPER_TRADING_FILE=paper_trades.json
PAPER_INITIAL_CASH=50000

# Optional; where the daily Kite access token is stored. Set both services to
# the same path so the UI login is visible to the headless trader.
# Docker compose already sets these to /data/... inside the containers.
KITE_TOKEN_FILE=.kite_token

# --- Real Zerodha orders (optional) ---
# Turn live mirroring on/off from the dashboard sidebar ("Real Zerodha orders").
# Skip NFO contracts below this OI (lots); Zerodha blocks MIS below ~500.
# MIN_MIS_OI_LOTS=500
# LIVE_KITE_PRODUCT=MIS
# Optional ceiling on top of live Zerodha margin (leave unset to use full Kite balance).
# LIVE_KITE_MAX_CAPITAL=50000
# LIVE_KITE_HARD_DISABLE=true  # emergency kill switch; ignores dashboard toggle
# LIMIT exit pricing when mirroring (bid preferred; else LTP minus this fraction).
# LIVE_EXIT_SLIPPAGE_PCT=0.05

# Shared trading policy (paper book and Zerodha mirroring use the same values).
# TRADER_MIN_CONFIDENCE=70
# TRADER_MAX_LOTS=1
# TRADER_MAX_DEPLOY_FRACTION=0.30
# TRADER_MAX_OPEN_POSITIONS=5
# TRADER_DAILY_LOSS_LIMIT=5000
# OPTION_REVERSAL_SCORE=2
# Book a winner at +12% of premium instead of waiting for +50%.
# OPTION_TAKE_PROFIT_FRACTION=0.12
# Cut a loser at −8% of premium. The stock's ATR stop is not used for options.
# OPTION_STOP_FRACTION=0.08
# After +6%, move the premium stop to entry so the trade cannot turn into a full stop-loss.
# OPTION_BREAKEVEN_ARM_FRACTION=0.06
# TRADER_BLOCK_PE_ABOVE_NIFTY_VWAP=true
# KITE_FETCH_ENTRY_COOLDOWN_MINUTES=30
# (Legacy LIVE_* names are still read as fallbacks.)
